# ===== Server =====
PORT=5000
NODE_ENV=development

# ===== Database =====
# Driver: "mysql" (production, per blueprint) or "sqlite" (local dev fallback)
DB_DRIVER=sqlite

# ---- MySQL (used when DB_DRIVER=mysql) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=student_clearance

# ---- SQLite (used when DB_DRIVER=sqlite) ----
# Path relative to backend/ root. Defaults to data/devdb.sqlite
DB_FILE=data/devdb.sqlite

# ===== Security =====
# JWT signing secret - replace with a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ===== CORS =====
CORS_ORIGIN=*